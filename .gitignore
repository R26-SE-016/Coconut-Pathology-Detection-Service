# ══════════════════════════════════════════════════════════════════════
# Coconut Pathology Detection Service — .gitignore
# ══════════════════════════════════════════════════════════════════════

# ── Python Virtual Environments ──────────────────────────────────────
venv/
.venv/
env/
ENV/
functions/venv/
functions/env/
functions/.venv/
env.bak/
venv.bak/

# ── Python Bytecode & Cache ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/

# ── Firebase & Cloud Functions Emulators ─────────────────────────────
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
pubsub-debug.log*
functions-debug.log*
*-debug.log
firebase-export*
.firebase/

# ── Environment Variables & Sensitive Credentials ────────────────────
.env
.env.*
.env.local
*serviceAccountKey*.json
*service_account*.json
*credentials*.json
*.pem
*.key
*.cert
*.secret
key.json
*key*.json

# ── OS & Editor Artifacts ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# ── Local Raw Raster Datasets & Heavy Weights ────────────────────────
# (Large drone GeoTIFFs or local checkpoints shouldn't bloat git repo)
*.tif
*.tiff
*.geotiff
*.weights
*.pth
*.pt
!models/system_b/system_b_baseline_int8.tflite
*.log
